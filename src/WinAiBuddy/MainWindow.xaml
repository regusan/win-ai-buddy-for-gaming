<Window x:Class="WinAiBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win AI Buddy"
        Width="1040"
        Height="760"
        MinWidth="820"
        MinHeight="640"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_OnClosing"
        StateChanged="Window_OnStateChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16">
                    <TextBlock Text="Win AI Buddy"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Gaming AI Coach"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextMuted}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Margin="20,0,20,16"
                           Foreground="{StaticResource TextMuted}"
                           Text="v1.5.1" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Main navigation -->
                        <RadioButton x:Name="NavDashboard"
                                     Content="Dashboard"
                                     IsChecked="True"
                                     Style="{StaticResource NavRadioButton}"
                                     Checked="NavDashboard_Checked" />
                        <RadioButton x:Name="NavHistory"
                                     Content="History"
                                     Style="{StaticResource NavRadioButton}"
                                     Checked="NavHistory_Checked" />

                        <!-- Settings divider -->
                        <Border Style="{StaticResource NavDividerStyle}" />
                        <TextBlock Text="SETTINGS" Style="{StaticResource NavGroupLabel}" />

                        <RadioButton x:Name="NavConnection"
                                     Content="Connection"
                                     Style="{StaticResource NavRadioButton}"
                                     Checked="NavConnection_Checked" />
                        <RadioButton x:Name="NavAudioCapture"
                                     Content="Audio &amp; Capture"
                                     Style="{StaticResource NavRadioButton}"
                                     Checked="NavAudioCapture_Checked" />
                        <RadioButton x:Name="NavOverlay"
                                     Content="Overlay"
                                     Style="{StaticResource NavRadioButton}"
                                     Checked="NavOverlay_Checked" />
                        <RadioButton x:Name="NavAiBehavior"
                                     Content="AI Behavior"
                                     Style="{StaticResource NavRadioButton}"
                                     Checked="NavAiBehavior_Checked" />
                        <RadioButton x:Name="NavGeneral"
                                     Content="General"
                                     Style="{StaticResource NavRadioButton}"
                                     Checked="NavGeneral_Checked" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== CONTENT AREA ===== -->
        <Grid Grid.Column="1">

            <!-- ===== DASHBOARD PANEL ===== -->
            <Grid x:Name="DashboardPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32">
                        <DockPanel>
                            <TextBlock Text="Dashboard"
                                       Style="{StaticResource SectionHeader}" />
                            <Border x:Name="SessionStatusPill"
                                    DockPanel.Dock="Right"
                                    Padding="14,6"
                                    CornerRadius="10"
                                    Background="{StaticResource AccentPrimaryMuted}">
                                <TextBlock x:Name="SessionStateTextBlock"
                                           Text="Stopped"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                            </Border>
                        </DockPanel>

                        <WrapPanel Margin="0,20,0,0">
                            <Button x:Name="StartSessionButton"
                                    Style="{StaticResource AccentButton}"
                                    Width="150"
                                    Height="40"
                                    Margin="0,0,10,10"
                                    Content="Start Session"
                                    Click="StartLiveButton_OnClick" />
                            <Button x:Name="StopSessionButton"
                                    Style="{StaticResource DangerButton}"
                                    Width="150"
                                    Height="40"
                                    Margin="0,0,10,10"
                                    Content="Stop Session"
                                    Click="StopLiveButton_OnClick" />
                            <Button Width="130"
                                    Height="40"
                                    Margin="0,0,10,10"
                                    Content="Hide to tray"
                                    Click="HideToTrayButton_OnClick" />
                        </WrapPanel>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Live status" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="StatusTextBlock"
                                           Margin="0,8,0,0"
                                           Text="Ready."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="You" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="InputTranscriptTextBlock"
                                               Margin="0,8,0,0"
                                               Text="Nothing heard yet."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Gemini" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="OutputTranscriptTextBlock"
                                               Margin="0,8,0,0"
                                               Text="No model response yet."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="LastSessionCard" Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Last session" Style="{StaticResource CardTitle}" />
                                        <TextBlock x:Name="LastSessionMeta"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                    <Button x:Name="DashboardResumeButton"
                                            DockPanel.Dock="Right"
                                            Width="120"
                                            Height="34"
                                            Content="Resume"
                                            Click="DashboardResumeButton_OnClick" />
                                </DockPanel>
                                <ItemsControl x:Name="LastSessionMessages" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Role}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding Text}"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextSecondary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="LastSessionPlaceholder"
                                   Margin="0,18,0,0"
                                   Text="No saved sessions yet."
                                   Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== HISTORY PANEL ===== -->
            <Grid x:Name="HistoryPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="20">
                            <TextBlock Text="Sessions" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Saved conversation transcripts"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>

                        <ListBox x:Name="ConversationSessionsListBox"
                                 Margin="12,0,12,12"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="ConversationSessionsListBox_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding DisplayMeta}"
                                                   Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="ConversationSessionHeaderTextBlock"
                                   Text="No session selected"
                                   Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="ConversationSessionMetaTextBlock"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMuted}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <ListBox x:Name="LogsListBox"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Role}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding DisplayTimestamp}"
                                                           Foreground="{StaticResource TextMuted}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="LogsPlaceholderTextBlock"
                                   Text="No messages in this session."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}" />
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="ResumeSessionButton"
                                Width="120"
                                Height="36"
                                Margin="0,0,10,0"
                                Content="Resume"
                                Click="ResumeSessionButton_OnClick" />
                        <Button Width="120"
                                Height="36"
                                Margin="0,0,10,0"
                                Content="Copy logs"
                                Click="CopyLogsButton_OnClick" />
                        <Button Width="120"
                                Height="36"
                                Content="Clear logs"
                                Click="ClearLogsButton_OnClick" />
                    </WrapPanel>
                </Grid>
            </Grid>

            <!-- ===== CONNECTION PANEL ===== -->
            <Grid x:Name="ConnectionPanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32">
                        <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Gemini Live API connection and model settings."
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMuted}" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="API key" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="ApiKeyPasswordBox"
                                             Margin="0,6,0,0" />

                                <TextBlock Text="Live model" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <ComboBox x:Name="LiveModelComboBox"
                                          Margin="0,6,0,0" />

                                <CheckBox x:Name="EnableAffectiveDialogCheckBox"
                                          Margin="0,14,0,0"
                                          Content="Enable affective dialog" />
                                <CheckBox x:Name="EnableProactiveAudioCheckBox"
                                          Margin="0,8,0,0"
                                          Content="Enable proactive audio" />

                                <CheckBox x:Name="EnableContextCompressionCheckBox"
                                          Margin="0,14,0,0"
                                          Content="Enable context window compression" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Compression trigger tokens" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ContextCompressionTriggerTokensTextBox" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Compression target tokens" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ContextCompressionTargetTokensTextBox" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Media resolution" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <ComboBox x:Name="MediaResolutionComboBox" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== AUDIO & CAPTURE PANEL ===== -->
            <Grid x:Name="AudioCapturePanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32">
                        <TextBlock Text="Audio &amp; Capture" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Microphone and screen input settings."
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMuted}" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Microphone" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="MicrophoneComboBox"
                                          Margin="0,6,0,0"
                                          SelectionChanged="MicrophoneComboBox_OnSelectionChanged" />
                                <Button Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Content="Refresh devices"
                                        Click="RefreshSourcesButton_OnClick" />

                                <TextBlock Text="Microphone gain" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <Slider x:Name="MicrophoneGainSlider"
                                        Minimum="0"
                                        Maximum="3"
                                        TickFrequency="0.1"
                                        ValueChanged="MicrophoneGainSlider_OnValueChanged" />
                                <TextBlock x:Name="MicrophoneGainValueTextBlock"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource TextMuted}" />

                                <ProgressBar x:Name="MicrophoneLevelProgressBar"
                                             Height="10"
                                             Margin="0,10,0,0"
                                             Minimum="0"
                                             Maximum="1" />

                                <TextBlock Text="Screen source" Style="{StaticResource FieldLabel}" Margin="0,18,0,0" />
                                <ComboBox x:Name="ScreenSourceComboBox"
                                          Margin="0,6,0,0"
                                          SelectionChanged="ScreenSourceComboBox_OnSelectionChanged" />

                                <CheckBox x:Name="StreamScreenFramesCheckBox"
                                          Margin="0,12,0,0"
                                          Content="Stream screen frames to Gemini Live" />

                                <TextBlock Text="Screen interval (ms)" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <DockPanel Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Width="36" Content="-" Click="ScreenIntervalDownButton_OnClick" />
                                        <Button Width="36" Margin="6,0,0,0" Content="+" Click="ScreenIntervalUpButton_OnClick" />
                                    </StackPanel>
                                    <TextBox x:Name="ScreenIntervalTextBox"
                                             PreviewTextInput="ScreenIntervalTextBox_OnPreviewTextInput"
                                             TextChanged="ScreenIntervalTextBox_OnTextChanged" />
                                </DockPanel>

                                <Border Margin="0,16,0,0"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8">
                                    <Image x:Name="ScreenPreviewImage"
                                           Height="220"
                                           Stretch="Uniform" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== OVERLAY PANEL ===== -->
            <Grid x:Name="OverlayPanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32">
                        <TextBlock Text="Overlay" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Configure the in-game coaching overlay."
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMuted}" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Display duration (seconds)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="OverlaySecondsTextBox" Margin="0,6,0,0" />

                                <TextBlock Text="Overlay opacity" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <Slider x:Name="OverlayOpacitySlider"
                                        Minimum="0"
                                        Maximum="1"
                                        ValueChanged="OverlayOpacitySlider_OnValueChanged" />
                                <TextBlock x:Name="OverlayOpacityValueTextBlock"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource TextMuted}" />

                                <TextBlock Text="Background opacity" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <Slider x:Name="OverlayBgOpacitySlider"
                                        Minimum="0"
                                        Maximum="1"
                                        ValueChanged="OverlayBgOpacitySlider_OnValueChanged" />
                                <TextBlock x:Name="OverlayBgOpacityValueTextBlock"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource TextMuted}" />

                                <TextBlock Text="Background color" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <TextBox x:Name="OverlayBgColorTextBox"
                                         Margin="0,6,0,0"
                                         TextChanged="OverlayPropertyTextBox_OnTextChanged" />

                                <TextBlock Text="Font size" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <TextBox x:Name="OverlayFontSizeTextBox"
                                         Margin="0,6,0,0"
                                         TextChanged="OverlayPropertyTextBox_OnTextChanged" />

                                <TextBlock Text="Text color" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <TextBox x:Name="OverlayTextColorTextBox"
                                         Margin="0,6,0,0"
                                         TextChanged="OverlayPropertyTextBox_OnTextChanged" />

                                <TextBlock Text="Outline color" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <TextBox x:Name="OverlayOutlineColorTextBox"
                                         Margin="0,6,0,0"
                                         TextChanged="OverlayPropertyTextBox_OnTextChanged" />

                                <TextBlock Text="Outline thickness" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <TextBox x:Name="OverlayOutlineThicknessTextBox"
                                         Margin="0,6,0,0"
                                         TextChanged="OverlayPropertyTextBox_OnTextChanged" />

                                <Border Margin="0,18,0,0"
                                        Padding="16"
                                        Background="{StaticResource OverlayPreviewBackground}"
                                        CornerRadius="10">
                                    <TextBlock x:Name="OverlayPreviewTextBlock"
                                               Text="Overlay preview"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center" />
                                </Border>

                                <WrapPanel Margin="0,16,0,0">
                                    <Button Width="130" Margin="0,0,10,10" Content="Test overlay" Click="OverlayTestButton_OnClick" />
                                    <Button Width="130" Margin="0,0,10,10" Content="Adjust position" Click="AdjustOverlayButton_OnClick" />
                                    <Button Width="130" Margin="0,0,10,10" Content="Lock overlay" Click="LockOverlayButton_OnClick" />
                                    <Button Width="130" Margin="0,0,10,10" Content="Reset position" Click="ResetOverlayPositionButton_OnClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== AI BEHAVIOR PANEL ===== -->
            <Grid x:Name="AiBehaviorPanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32">
                        <TextBlock Text="AI Behavior" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Thinking and system prompt settings."
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMuted}" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Thinking mode" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ThinkingModeComboBox"
                                          Margin="0,6,0,0"
                                          SelectionChanged="ThinkingModeComboBox_OnSelectionChanged" />

                                <TextBlock Text="Thinking budget" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <TextBox x:Name="ThinkingBudgetTextBox" Margin="0,6,0,0" />

                                <TextBlock Text="Thinking level" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <ComboBox x:Name="ThinkingLevelComboBox" Margin="0,6,0,0" />

                                <CheckBox x:Name="IncludeThoughtsCheckBox"
                                          Margin="0,12,0,0"
                                          Content="Include thoughts" />

                                <TextBlock Text="System prompt" Style="{StaticResource FieldLabel}" Margin="0,18,0,0" />
                                <TextBox x:Name="SystemPromptTextBox"
                                         Margin="0,6,0,0"
                                         Height="180"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== GENERAL PANEL ===== -->
            <Grid x:Name="GeneralPanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32">
                        <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Startup and appearance settings."
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMuted}" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="AppThemeComboBox" Margin="0,6,0,0" />

                                <CheckBox x:Name="AutoStartSessionCheckBox"
                                          Margin="0,14,0,0"
                                          Content="Start Live session automatically" />
                                <CheckBox x:Name="StartMinimizedCheckBox"
                                          Margin="0,8,0,0"
                                          Content="Start minimized to tray" />

                                <WrapPanel Margin="0,16,0,0">
                                    <Button Width="120" Margin="0,0,10,10" Content="Save" Click="SaveButton_OnClick" />
                                    <Button Width="120" Margin="0,0,10,10" Content="Exit app" Click="ExitAppButton_OnClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Window>
